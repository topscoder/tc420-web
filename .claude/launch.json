{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tc420-webapp",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8420",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8420
    },
    {
      "name": "tc420-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8434",
        "--bind",
