{
  "name": "tc420-web",
  "version": "1.0.0",
  "private": true,
  "description": "Edit the lighting schedules of a TC420 LED controller and send them over USB from the browser, without internet or other software.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "serve": "python3 -m http.server 8420 --bind 127.0.0.1 --directory webapp",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/topscoder/tc420-web.git"
  },
  "homepage": "https://topscoder.github.io/tc420-web/"
}
